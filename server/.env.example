NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/smartmail
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_TTL=7d

# SMTP used to deliver signup email verification codes. Keep these credentials server-side.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/callback
GMAIL_SYNC_LIMIT=100
# Poll connected Gmail accounts for new messages every 60 seconds.
GMAIL_AUTO_SYNC_INTERVAL_MS=60000

AI_PROVIDER=gemini
# Leave blank to use the provider default (Gemini: gemini-3.1-flash-lite, OpenAI: gpt-4o-mini).
AI_MODEL=
AI_WORKER_CONCURRENCY=1
AI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_CONTEXT_CHARS=24000
# Leave blank to use the provider default. Both defaults use 768 dimensions below.
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768
VECTOR_INDEX_NAME=smartmail_email_vector

# Optional in local development; required to process jobs in a separate worker.
REDIS_URL=
COOKIE_DOMAIN=
TRUST_PROXY=0
